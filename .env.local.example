# ──────────────────────────────────────────────────────────────
# XtraWine Phase Zero — variabili d'ambiente
# Copia questo file in .env.local e compila tutti i valori.
# NON committare .env.local su git.
# ──────────────────────────────────────────────────────────────

# Shopify Custom App (da Partner Dashboard)
SHOPIFY_STORE_DOMAIN=xtrawine.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Webhook HMAC secret = client secret (stesso valore — Shopify 2026 non ha secret separato per webhook)
SHOPIFY_WEBHOOK_SECRET=  # copia il valore di SHOPIFY_CLIENT_SECRET

# Vercel KV — viene pre-compilato automaticamente da Vercel se usi
# il progetto collegato. In locale usa le credenziali da vercel env pull.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Klaviyo (Private API Key con scope Events - Write)
KLAVIYO_API_KEY=

# App
APP_BASE_URL=https://xtrawine-phase-zero.vercel.app

# Experience: valore esatto del campo "Product type" su Shopify
EXPERIENCE_PRODUCT_TYPE=Experience

# Voucher: stringa random >= 32 caratteri — genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOUCHER_SECRET_SALT=

# ERP: token condiviso con il sistema ERP per /api/order-vouchers
ERP_SHARED_SECRET=

# Ritardo invio email su ordini PayPal (minuti, default 30)
PAYPAL_DELAY_MINUTES=30

# Validità codice sconto cross-selling (giorni, default 365 = 1 anno)
DISCOUNT_VALIDITY_DAYS=365
